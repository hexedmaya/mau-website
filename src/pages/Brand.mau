<script>
  const logos = [
    { file: "logo.svg", label: "logo, light", bg: "paper" },
    { file: "logo-dark.svg", label: "logo, dark", bg: "ink" },
    { file: "logo-mono.svg", label: "logo, one color", bg: "paper" },
    { file: "icon.svg", label: "icon", bg: "paper" },
  ];

  const downloads = [
    { file: "logo.svg", note: "svg, for light backgrounds" },
    { file: "logo-dark.svg", note: "svg, for dark backgrounds" },
    { file: "logo-mono.svg", note: "svg, takes the text color" },
    { file: "icon.svg", note: "svg, square icon" },
    { file: "png/mau-avatar-512.png", note: "png, 512 x 512, avatar" },
    { file: "png/mau-logo-2048-dark.png", note: "png, 2048 x 2048, dark" },
    { file: "png/mau-logo-transparent-512.png", note: "png, 512 x 512, transparent, for light" },
    { file: "png/mau-logo-transparent-dark-512.png", note: "png, 512 x 512, transparent, for dark" },
    { file: "png/mau-social-1280x640.png", note: "png, 1280 x 640, social preview" },
  ];

  const colors = [
    { name: "ink", hex: "#141414" },
    { name: "paper", hex: "#f1eee4" },
    { name: "orange", hex: "#ff4b1f" },
    { name: "ink, dark mode", hex: "#efeadc" },
    { name: "paper, dark mode", hex: "#131311" },
    { name: "orange, dark mode", hex: "#ff5a2b" },
  ];

  // the policy is BRAND-POLICY.md next to the page, turned into simple blocks
  const blocks = signal([]);
  const failed = signal(false);

  function parse(md) {
    const out = [];
    let para = [], list = null, quote = null;
    const flush = () => {
      if (para.length) out.push({ t: "p", text: para.join(" ") });
      if (list) out.push({ t: "ul", items: list });
      if (quote) out.push({ t: "quote", text: quote.join("\n") });
      para = []; list = null; quote = null;
    };
    for (const line of md.split(/\r?\n/)) {
      if (/^#{1,3} /.test(line)) {
        flush();
        if (!line.startsWith("# ")) out.push({ t: "h", text: line.replace(/^#+ /, "") });
      } else if (line.startsWith("* ")) {
        if (!list) flush();
        (list ??= []).push(line.slice(2));
      } else if (line.startsWith("> ")) {
        if (!quote) flush();
        (quote ??= []).push(line.slice(2));
      } else if (!line.trim()) flush();
      else {
        if (list || quote) flush();
        para.push(line);
      }
    }
    flush();
    return out;
  }

  fetch("BRAND-POLICY.md")
    .then((r) => (r.ok ? r.text() : Promise.reject(new Error("not found"))))
    .then((text) => blocks.set(parse(text)))
    .catch(() => failed.set(true));
</script>

<section class="brand-page">
  <h1 class="head">brand</h1>
  <p class="intro">The mau name and logo, and how you may use them.</p>

  <h2 class="label">logo</h2>
  <div class="tiles">
    {#each logos as l (l.file)}
      <figure class="tile {l.bg}">
        <img src={"brand/" + l.file} alt={"mau " + l.label}>
        <figcaption>{l.label}</figcaption>
      </figure>
    {/each}
  </div>

  <h2 class="label">downloads</h2>
  <ul class="files">
    {#each downloads as d (d.file)}
      <li><a href={"brand/" + d.file} download>{d.file}</a> <span>{d.note}</span></li>
    {/each}
  </ul>

  <h2 class="label">colors</h2>
  <div class="colors">
    {#each colors as c (c.name)}
      <div class="swatch">
        <span class="chip" style={{ background: c.hex }}></span>
        <b>{c.name}</b>
        <code>{c.hex}</code>
      </div>
    {/each}
  </div>

  <h2 class="label">brand policy</h2>
  <div class="policy">
    {#if failed()}
      <p class="note">The policy could not be loaded. It is the file <a href="BRAND-POLICY.md">BRAND-POLICY.md</a>.</p>
    {/if}
    {#each blocks() as b}
      {#if b.t === "h"}
        <h3>{b.text}</h3>
      {:else if b.t === "ul"}
        <ul>{#each b.items as it}<li>{it}</li>{/each}</ul>
      {:else if b.t === "quote"}
        <blockquote>{b.text}</blockquote>
      {:else}
        <p>{b.text}</p>
      {/if}
    {/each}
  </div>
</section>

<style>
  :scope { padding: clamp(2rem, 6vw, 4rem) clamp(1rem, 4vw, 2.5rem) 3rem; }
  .head { margin: 0 0 .6rem; font-size: clamp(3.5rem, 13vw, 8rem); line-height: .85; font-weight: 900; letter-spacing: -.06em; }
  .intro { max-width: 36rem; margin: 0 0 2.5rem; font-size: 1.2rem; }
  .label { margin: 3rem 0 1.2rem; padding-top: 1.2rem; border-top: 2px solid var(--ink); font-family: var(--mono); font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; }

  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 1rem; }
  .tile { margin: 0; border: 2px solid var(--ink); }
  .tile img { display: block; width: 100%; height: 11rem; object-fit: contain; padding: 1.6rem; box-sizing: border-box; }
  .tile.paper img { background: #f1eee4; }
  .tile.ink img { background: #131311; }
  .tile figcaption { padding: .5rem .8rem; border-top: 2px solid var(--ink); font-family: var(--mono); font-size: .8rem; }

  .files { list-style: none; margin: 0; padding: 0; font-family: var(--mono); font-size: .88rem; }
  .files li { display: flex; flex-wrap: wrap; gap: .3rem 1.2rem; padding: .5rem 0; border-bottom: 1px dashed var(--mute); }
  .files a { color: var(--ink); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .2em; }
  .files a:hover { background: var(--accent); color: #000; text-decoration: none; }
  .files span { color: var(--mute); }

  .colors { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 1rem; }
  .swatch { display: flex; flex-direction: column; gap: .2rem; }
  .chip { display: block; height: 4.5rem; border: 2px solid var(--ink); }
  .swatch code { font-family: var(--mono); font-size: .85rem; color: var(--mute); }

  .policy { max-width: 46rem; }
  .policy h3 { margin: 2rem 0 .5rem; font-size: 1.25rem; letter-spacing: -.01em; }
  .policy p { margin: 0 0 .8rem; }
  .policy ul { margin: 0 0 1rem; padding-left: 1.2rem; }
  .policy li { margin: .2rem 0; }
  .policy blockquote { margin: 0 0 1rem; padding: .6rem 1rem; border-left: 4px solid var(--accent); white-space: pre-line; font-family: var(--mono); font-size: .9rem; }
  .note { font-family: var(--mono); }
</style>
