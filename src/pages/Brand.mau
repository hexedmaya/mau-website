<script>
  const logos = [
    { file: "logo.svg", label: "logo, light", bg: "paper" },
    { file: "logo-dark.svg", label: "logo, dark", bg: "ink" },
    { file: "logo-mono.svg", label: "logo, one color", bg: "paper" },
    { file: "icon.svg", label: "icon", bg: "paper" },
  ];

  const downloads = [
    { file: "logo.svg", note: "svg, for light backgrounds" },
    { file: "logo-dark.svg", note: "svg, for dark backgrounds" },
    { file: "logo-mono.svg", note: "svg, takes the text color" },
    { file: "icon.svg", note: "svg, square icon" },
    { file: "png/mau-logo-512.png", note: "png, 512 x 512, transparent, for light backgrounds" },
    { file: "png/mau-logo-dark-512.png", note: "png, 512 x 512, transparent, for dark backgrounds" },
    { file: "png/mau-logo-mono-512.png", note: "png, 512 x 512, transparent, one color (black)" },
    { file: "png/mau-icon-512.png", note: "png, 512 x 512, square icon, avatar" },
    { file: "png/mau-social-1280x640.png", note: "png, 1280 x 640, social preview" },
  ];

  const colors = [
    { name: "ink", hex: "#141414" },
    { name: "paper", hex: "#f1eee4" },
    { name: "orange", hex: "#ff4b1f" },
    { name: "ink, dark mode", hex: "#efeadc" },
    { name: "paper, dark mode", hex: "#131311" },
    { name: "orange, dark mode", hex: "#ff5a2b" },
  ];
</script>

<section class="brand-page">
  <h1 class="head">brand</h1>
  <p class="intro">The mau name and logo, and how you may use them.</p>

  <h2 class="label">logo</h2>
  <div class="tiles">
    {#each logos as l (l.file)}
      <figure class="tile {l.bg}">
        <img src={"/assets/brand/" + l.file} alt={"mau " + l.label}>
        <figcaption>{l.label}</figcaption>
      </figure>
    {/each}
  </div>

  <h2 class="label">downloads</h2>
  <ul class="files">
    {#each downloads as d (d.file)}
      <li><a href={"/assets/brand/" + d.file} download>{d.file}</a> <span>{d.note}</span></li>
    {/each}
  </ul>

  <h2 class="label">colors</h2>
  <div class="colors">
    {#each colors as c (c.name)}
      <div class="swatch">
        <span class="chip" style={{ background: c.hex }}></span>
        <b>{c.name}</b>
        <code>{c.hex}</code>
      </div>
    {/each}
  </div>

  <h2 class="label">brand policy</h2>
  <p class="policy">How you may use the mau name and logo: <a href="/brand-policy">read the brand policy</a>.</p>
</section>

