<script>
  const clicks = signal(0);
  const todos = signal([
    { id: 1, text: "read the source" },
    { id: 2, text: "compile it" },
    { id: 3, text: "ship plain JS" },
  ]);
  const draft = signal("");
  let next = 4;

  const add = () => {
    const text = draft().trim();
    if (!text) return;
    todos.set([{ id: next++, text }, ...todos()]);
    draft.set("");
  };
  const remove = (id) => todos.set(todos().filter((t) => t.id !== id));

  // polled data: every second the array is replaced with new objects
  const clamp = (v) => Math.max(0, Math.min(100, v));
  const instances = signal([
    { id: 1, name: "web-01", cpu: 32, on: true },
    { id: 2, name: "db-01", cpu: 58, on: true },
    { id: 3, name: "cache", cpu: 12, on: true },
    { id: 4, name: "worker-a", cpu: 0, on: false },
  ]);
  const timer = setInterval(() => {
    instances.set(instances().map((x) => (x.on ? { ...x, cpu: clamp(Math.round(x.cpu + (Math.random() - 0.5) * 24)) } : x)));
  }, 1000);
  onDestroy(() => clearInterval(timer));
  const toggle = (id) => instances.set(instances().map((x) => (x.id === id ? { ...x, on: !x.on, cpu: x.on ? 0 : 20 } : x)));

  const liveSource = `{#each instances() as i (i.id)}
  <li>
    {i.name}
    <svg viewBox="0 0 100 8">
      <rect width={i.cpu} height="8" />
    </svg>
    {i.cpu}%
  </li>
{/each}`;

  const source = `<button on:click={inc}>
  clicked {n()} times
</button>

<input bind:value={draft}>

{#each todos() as t (t.id)}
  <li>
    {t.text}
    <button on:click={() => remove(t.id)}>x</button>
  </li>
{/each}`;
</script>

<section class="demo" id="demo">
  <h2 class="label">try it (this page is .mau, too)</h2>

  <div class="split">
    <div class="panel">
      <button class="count" on:click={() => clicks.set(clicks() + 1)}>
        clicked {clicks()} {clicks() === 1 ? "time" : "times"}
      </button>

      <div class="add">
        <input bind:value={draft} placeholder="new task" on:keydown={(e) => e.key === "Enter" && add()}>
        <button class="go" on:click={add}>add</button>
      </div>

      <ul class="list">
        {#each todos() as t (t.id)}
          <li>
            <span>{t.text}</span>
            <button class="x" on:click={() => remove(t.id)} title="remove">x</button>
          </li>
        {/each}
      </ul>
      {#if todos().length === 0}
        <p class="empty">nothing left.</p>
      {/if}
    </div>

    <pre class="src"><code>{source}</code></pre>
  </div>

  <h2 class="label second">live list: polled data, rows update in place</h2>
  <div class="split">
    <div class="panel">
      <ul class="inst">
        {#each instances() as i (i.id)}
          <li class={i.on ? "on" : "off"}>
            <span class="name">{i.name}</span>
            <svg class="bar" viewBox="0 0 100 8" preserveAspectRatio="none">
              <rect class="track" width="100" height="8" />
              <rect class="fill" width={i.cpu} height="8" />
            </svg>
            <span class="cpu">{i.cpu}%</span>
            <button class="tog" on:click={() => toggle(i.id)}>{i.on ? "stop" : "start"}</button>
          </li>
        {/each}
      </ul>
      <p class="note">Every second the array is replaced with new objects. The rows stay, only the changed values are written.</p>
    </div>

    <pre class="src"><code>{liveSource}</code></pre>
  </div>
</section>

<style>
  :scope { padding: 3rem clamp(1rem, 4vw, 2.5rem); border-bottom: 2px solid var(--ink); }
  .label { margin: 0 0 1.4rem; font-family: var(--mono); font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start; }
  @media (max-width: 760px) { .split { grid-template-columns: minmax(0, 1fr); } }
  .split > * { min-width: 0; }
  .panel { padding: 1.2rem; border: 2px solid var(--ink); box-shadow: 8px 8px 0 var(--ink); }
  .src { margin: 0; padding: 1.2rem; overflow: auto; background: var(--ink); color: var(--paper); font-family: var(--mono); font-size: .82rem; line-height: 1.65; }
  .src code { font-family: inherit; }
  button, input { font: inherit; color: var(--ink); border-radius: 0; }
  .count { width: 100%; cursor: pointer; padding: .8rem; font-weight: 700; background: var(--paper); border: 2px solid var(--ink); text-align: left; }
  .count:hover { background: var(--accent); color: #000; }
  .count:active { background: var(--ink); color: var(--paper); }
  .add { display: flex; margin: 1rem 0; }
  .add input { flex: 1; min-width: 0; padding: .6rem .8rem; background: var(--paper); border: 2px solid var(--ink); border-right: 0; }
  .add input:focus { outline: 3px solid var(--accent); outline-offset: -3px; }
  .go { cursor: pointer; padding: 0 1.2rem; font-weight: 700; color: #000; background: var(--accent); border: 2px solid var(--ink); }
  .go:active { background: var(--ink); color: var(--paper); }
  .list { list-style: none; margin: 0; padding: 0; }
  .list li { display: flex; justify-content: space-between; align-items: center; padding: .5rem 0; border-bottom: 1px dashed var(--mute); }
  .x { cursor: pointer; font-family: var(--mono); background: none; border: 2px solid transparent; padding: 0 .5rem; }
  .x:hover { border-color: var(--ink); background: var(--accent); color: #000; }
  .empty { margin: .8rem 0 0; font-family: var(--mono); color: var(--mute); }

  .second { margin-top: 3.5rem; }
  .inst { list-style: none; margin: 0; padding: 0; }
  .inst li { display: grid; grid-template-columns: 6.5rem 1fr 3rem auto; gap: .7rem; align-items: center; padding: .55rem 0; border-bottom: 1px dashed var(--mute); }
  .inst li.off .name, .inst li.off .cpu { color: var(--mute); }
  @media (max-width: 480px) {
    .inst li { grid-template-columns: 4.6rem minmax(2rem, 1fr) 2.4rem auto; gap: .5rem; }
    .panel { padding: 1rem; }
  }
  .name { font-family: var(--mono); font-size: .9rem; }
  .cpu { font-family: var(--mono); font-size: .9rem; text-align: right; font-variant-numeric: tabular-nums; }
  .bar { width: 100%; height: .9rem; display: block; }
  .track { fill: none; stroke: var(--ink); stroke-width: 2; vector-effect: non-scaling-stroke; }
  .fill { fill: var(--accent); transition: width .5s linear; }
  .tog { cursor: pointer; font-family: var(--mono); font-size: .8rem; padding: .15rem .6rem; background: var(--paper); border: 2px solid var(--ink); }
  .tog:hover { background: var(--accent); color: #000; }
  .note { margin: .9rem 0 0; color: var(--mute); font-size: .9rem; }
</style>
