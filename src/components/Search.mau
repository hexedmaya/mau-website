<script>
  import { find } from "../content/search.js";

  const q = signal("");
  const results = computed(() => find(q()));
  const open = computed(() => q().trim().length >= 2);
  const clear = () => q.set("");
</script>

<div class="search">
  <input type="search" bind:value={q} placeholder="search the docs" autocomplete="off" aria-label="search the docs" on:keydown={(e) => e.key === "Escape" && clear()}>
  {#if open()}
    <ul class="hits">
      {#each results() as r (r.slug + r.id)}
        <li>
          <a href={"/docs/" + r.slug + "#" + r.id} on:click={clear}>
            <b>{r.title} › {r.h}</b>
            <span>{r.body.slice(0, 110)}</span>
          </a>
        </li>
      {/each}
    </ul>
    {#if results().length === 0}
      <p class="none">nothing found for "{q().trim()}".</p>
    {/if}
  {/if}
</div>

<style>
  :scope { margin: 0 0 1.6rem; max-width: 34rem; }
  input {
    width: 100%; box-sizing: border-box; font: inherit; font-family: var(--mono); font-size: .9rem;
    color: var(--ink); background: var(--paper); border: 2px solid var(--ink); padding: .6rem .8rem;
  }
  input:focus { outline: 3px solid var(--accent); outline-offset: -3px; }
  .hits { list-style: none; margin: 0; padding: 0; border: 2px solid var(--ink); border-top: 0; }
  .hits li { border-top: 1px dashed var(--mute); }
  .hits li:first-child { border-top: 0; }
  .hits a { display: block; padding: .6rem .8rem; color: var(--ink); text-decoration: none; }
  .hits a:hover { background: var(--accent); color: #000; }
  .hits b { display: block; font-size: .9rem; }
  .hits span { display: block; font-size: .8rem; color: var(--mute); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hits a:hover span { color: #000; }
  .none { margin: .6rem 0 0; font-family: var(--mono); font-size: .85rem; color: var(--mute); }
</style>
