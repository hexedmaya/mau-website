  }
  .rows li:hover { background: var(--ink); color: var(--paper); }
  .n { font-family: var(--mono); color: var(--accent); font-weight: 700; }
  .t { font-size: 1.25rem; letter-spacing: -.01em; }
  .d { color: var(--mute); }
  .rows li:hover .d { color: var(--paper); }
