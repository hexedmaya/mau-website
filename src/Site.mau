<script>
  import Home from "./pages/Home.js";
  import Start from "./pages/Start.js";
  import Docs from "./pages/Docs.js";
  import Try from "./pages/Try.js";
  import About from "./pages/About.js";
  import Brand from "./pages/Brand.js";
  import Legal from "./pages/Legal.js";
  import Playground from "./pages/Playground.js";
  import NotFound from "./pages/NotFound.js";
  import Footer from "./components/Footer.js";
  import { titleFor } from "./content/pages.js";
  import { links as ext } from "./content/links.js";

  const view = router({
    "/": Home,
    "/start": Start,
    "/docs": Docs,
    "/docs/:page": Docs,
    "/try": Try,
    "/playground": Playground,
    "/about": About,
    "/brand": Brand,
    "/brand-policy": Legal,
    "/licenses": Legal,
    "/licenses/website": Legal,
    "/imprint": Legal,
    "/privacy": Legal,
    "*": NotFound,
  });

  // light or dark: the choice of the visitor (kept in this browser), else the mode of the system
  const saved = () => { try { const t = localStorage.getItem("mau-theme"); return t === "light" || t === "dark" ? t : null; } catch (e) { return null; } };
  const systemDark = typeof matchMedia === "function" && matchMedia("(prefers-color-scheme: dark)").matches;
  const theme = signal(saved() ?? (systemDark ? "dark" : "light"));
  const toggle = () => {
    const next = theme() === "dark" ? "light" : "dark";
    theme.set(next);
    try { localStorage.setItem("mau-theme", next); } catch (e) {}
  };
  effect(() => document.documentElement.setAttribute("data-theme", theme()));

  // phones: the links sit behind a menu button. Any move to another page closes it.
  const menu = signal(false);
  effect(() => { route(); menu.set(false); });

  const links = [
    { to: "/docs", label: "docs" },
    { to: "/try", label: "try" },
    { to: "/playground", label: "playground" },
  ];

  // the tab shows the title of the page. A link with #anchor scrolls to it once the page is drawn, every other page starts at the top
  effect(() => {
    document.title = titleFor(route().path);
    const id = decodeURIComponent(location.hash.slice(1));
    queueMicrotask(() => {
      const target = id && document.getElementById(id);
      if (target) target.scrollIntoView();
      else window.scrollTo({ top: 0, behavior: "instant" });
    });
  });
</script>

<div class={"site " + theme()}>
  <nav class="topbar">
    <a class="brand" href="/" aria-label="mau, home">
      <svg viewBox="0 0 28 24" aria-hidden="true"><path d="M2 21V3l6 6h6l6-6v18h-4v-8h-3v8H9v-8H6v8z" /><rect class="dot" x="22" y="17" width="4" height="4" /></svg>
      <span>mau</span>
    </a>
    <button class="burger" on:click={() => menu.set(!menu())} aria-expanded={menu() ? "true" : "false"} aria-controls="site-links">{menu() ? "close" : "menu"}</button>
    <div class={menu() ? "links open" : "links"} id="site-links">
      {#each links as l (l.to)}
        <a href={l.to} class={route().path.startsWith(l.to) ? "on" : ""} aria-current={route().path.startsWith(l.to) ? "page" : null}>{l.label}</a>
      {/each}
      <a class="gh" href={ext.mau} target="_blank" rel="noopener">github ↗</a>
      <button class="mode" on:click={toggle} aria-label={theme() === "dark" ? "switch to light mode" : "switch to dark mode"}>{theme() === "dark" ? "light" : "dark"}</button>
    </div>
  </nav>
  <main>{view()}</main>
  <Footer />
</div>

<style>
  :scope {
    --paper: #f1eee4; --ink: #141414; --mute: #6b6759; --accent: #ff4b1f;
    --mono: ui-monospace, "Cascadia Code", "SF Mono", Consolas, monospace;
    min-height: 100vh; min-height: 100dvh;
    display: flex; flex-direction: column;
    background: var(--paper); color: var(--ink);
    font: 17px/1.55 "Helvetica Neue", Arial, system-ui, sans-serif;
  }
  :scope.dark { --paper: #131311; --ink: #efeadc; --mute: #958f7d; --accent: #ff5a2b; }
  :global(::selection) { background: var(--accent); color: #000; }

  /* scrollbars: square, ink on paper, orange on hover (Chrome, Edge, Safari) */
  :scope, :scope :global(*) { scrollbar-width: auto; }
  :scope::-webkit-scrollbar, :scope :global(*)::-webkit-scrollbar { width: 14px; height: 14px; }
  :scope::-webkit-scrollbar-track, :scope :global(*)::-webkit-scrollbar-track { background: var(--paper); border-left: 2px solid var(--ink); }
  :scope::-webkit-scrollbar-thumb, :scope :global(*)::-webkit-scrollbar-thumb { background: var(--ink); border: 3px solid var(--paper); }
  :scope::-webkit-scrollbar-thumb:hover, :scope :global(*)::-webkit-scrollbar-thumb:hover { background: var(--accent); }
  :scope::-webkit-scrollbar-corner, :scope :global(*)::-webkit-scrollbar-corner { background: var(--paper); }
  /* code blocks are ink coloured, so their scrollbar is inverted */
  :global(pre)::-webkit-scrollbar-track { background: var(--ink); border-left: 0; border-top: 2px solid var(--paper); }
  :global(pre)::-webkit-scrollbar-thumb { background: var(--paper); border-color: var(--ink); }
  :global(pre)::-webkit-scrollbar-thumb:hover { background: var(--accent); }
  /* Firefox has no pseudo-elements, only colour and width */
  @supports not selector(::-webkit-scrollbar) {
    :scope { scrollbar-width: thin; scrollbar-color: var(--ink) var(--paper); }
    :global(pre) { scrollbar-color: var(--paper) var(--ink); }
  }
  main { flex: 1 0 auto; min-width: 0; }
  .topbar {
    position: sticky; top: 0; z-index: 5; background: var(--paper);
    display: flex; justify-content: space-between; align-items: baseline;
    padding: .8rem clamp(1rem, 4vw, 2.5rem); border-bottom: 2px solid var(--ink);
    font-family: var(--mono); font-size: .85rem;
  }
  .brand { display: inline-flex; align-items: center; gap: .55rem; font-weight: 800; font-size: 1.05rem; color: var(--ink); text-decoration: none; }
  .brand svg { height: 1.15rem; width: auto; fill: var(--ink); }
  .brand .dot { fill: var(--accent); }
  .links a { margin-left: 1.3rem; color: var(--ink); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .25em; }
  .mode { margin-left: 1.3rem; padding: .1rem .55rem; font: inherit; cursor: pointer; color: var(--ink); background: transparent; border: 2px solid var(--ink); }
  @media (hover: hover) { .mode:hover { background: var(--accent); border-color: var(--accent); color: #000; } }
  .links a.on { background: var(--accent); color: #000; text-decoration: none; }
  @media (hover: hover) { .links a:hover { background: var(--accent); color: #000; text-decoration: none; } }
  .burger { display: none; }
  /* phones: the links open under the bar from a menu button (after the base rules, so it wins) */
  @media (max-width: 700px) {
    .topbar { flex-wrap: wrap; align-items: center; }
    .burger { display: block; padding: .25rem .8rem; font: inherit; cursor: pointer; color: var(--ink); background: transparent; border: 2px solid var(--ink); }
    .links { display: none; flex: 0 0 calc(100% + 2 * clamp(1rem, 4vw, 2.5rem)); flex-direction: column; margin: .7rem calc(-1 * clamp(1rem, 4vw, 2.5rem)) -.8rem; border-top: 2px solid var(--ink); }
    .links.open { display: flex; }
    .links a { margin: 0; padding: .8rem clamp(1rem, 4vw, 2.5rem); border-bottom: 2px solid var(--ink); text-decoration: none; font-size: 1rem; }
    .mode { margin: 0; padding: .8rem clamp(1rem, 4vw, 2.5rem); text-align: left; border: 0; font-size: 1rem; }
  }
</style>
